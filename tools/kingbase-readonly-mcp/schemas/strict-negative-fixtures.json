{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strict-negative-fixtures.json",
  "title": "真实 Kingbase MCP 严格 Schema/语义负例清单",
  "description": "离线 harness 必须在不启动 psql 的前提下逐项验证：19 项由 Ajv 2020 strict 拒绝，18 项先通过 request/response Schema 和所有非目标 digest/context 前置检查，再由同一会话 queryContext 驱动的语义闭集 validator 仅因目标规则拒绝。",
  "type": "array",
  "minItems": 37,
  "maxItems": 37,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "caseId",
      "target",
      "payload",
      "expectedErrorCode",
      "mustNotStartPsql"
    ],
    "properties": {
      "caseId": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$",
        "maxLength": 64
      },
      "target": {
        "enum": [
          "catalogRequest",
          "catalogResponse",
          "preflightResponse"
        ]
      },
      "payload": {
        "type": "object"
      },
      "request": {
        "type": "object"
      },
      "queryContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestCanonicalSha256",
          "operation",
          "dataAsOf",
          "directEdges"
        ],
        "properties": {
          "requestCanonicalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "operation": {
            "enum": [
              "RESOLVE_CATALOG",
              "SEARCH_PRODUCTS",
              "PRODUCT_INDUSTRIES",
              "INDUSTRY_CHILDREN",
              "INDUSTRY_PARENT_PATH"
            ]
          },
          "dataAsOf": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "parentEntityId": {
            "type": "string",
            "maxLength": 128
          },
          "productEntityId": {
            "type": "string",
            "maxLength": 128
          },
          "canonicalProductId": {
            "type": "string",
            "maxLength": 128
          },
          "directEdges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parentEntityId",
                "parentLevel",
                "childEntityId",
                "childLevel"
              ],
              "properties": {
                "parentEntityId": {
                  "type": "string",
                  "maxLength": 128
                },
                "parentLevel": {
                  "enum": [
                    "ROOT",
                    "L1",
                    "L2"
                  ]
                },
                "childEntityId": {
                  "type": "string",
                  "maxLength": 128
                },
                "childLevel": {
                  "enum": [
                    "L1",
                    "L2",
                    "L3"
                  ]
                }
              }
            }
          }
        }
      },
      "semanticRule": {
        "enum": [
          "COUNT_RETURNED_NOT_GT_TOTAL",
          "TRUNCATED_EQ_TOTAL_GT_RETURNED",
          "CHILD_LEVEL",
          "PATH_LEVEL_ORDER",
          "PATH_TARGET_BINDING",
          "PATH_DIRECT_PARENT",
          "PRODUCT_ID_BINDING",
          "RESOLVE_MATCH_FIELD",
          "REQUEST_LIMIT_BINDING",
          "RESPONSE_OPERATION_BINDING",
          "CONTEXT_OPERATION_BINDING",
          "CONTEXT_REQUEST_DIGEST",
          "CONTEXT_DATA_AS_OF",
          "CONTEXT_EDGE_UNIQUE",
          "CONTEXT_REQUIRED_BINDING",
          "PRODUCT_REQUEST_BINDING",
          "CHILD_PARENT_BINDING",
          "CHILD_DIRECT_PARENT",
          "PRODUCT_PATH_DIRECT_PARENT"
        ]
      },
      "expectedErrorCode": {
        "enum": [
          "POLICY_DENIED",
          "DATA_CONTRACT_MISMATCH"
        ]
      },
      "mustNotStartPsql": {
        "const": true
      }
    }
  },
