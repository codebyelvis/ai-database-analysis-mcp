{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kingbase-readonly-preflight.response.schema.json",
  "title": "测试环境 Kingbase 只读 MCP preflight 响应",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "operation", "profile", "schema", "readBoundary", "objects", "dataAsOf", "queryId"],
  "properties": {
    "success": { "type": "boolean" },
    "operation": { "const": "kingbase_readonly_preflight" },
    "profile": { "const": "ai_app_industry_test_ro" },
    "schema": { "const": "ai_dw" },
    "readBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transactionReadOnly", "privilegeMode", "databasePrivilegeRisk"],
          "properties": {
            "transactionReadOnly": { "const": true },
            "privilegeMode": { "enum": ["DATABASE_READ_ONLY", "CLIENT_ENFORCED_READ_ONLY"] },
            "databasePrivilegeRisk": { "enum": ["NONE_OBSERVED", "WRITE_CAPABLE_ACCOUNT"] }
          }
        },
        { "type": "null" }
      ]
    },
    "objects": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "rowCount", "uniqueKeyCount", "columns"],
        "properties": {
          "table": { "enum": ["T_EDW_VAR_PD_INFO_Q", "T_EDW_VAR_PD_IDTY_RELA_Q", "T_EDW_VAR_HCZQ_IDTY_CLAS_Q"] },
          "rowCount": { "type": "integer", "minimum": 0 },
          "uniqueKeyCount": { "type": "integer", "minimum": 0 },
          "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$" } }
        }
      }
    },
    "dataAsOf": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" }] },
    "queryId": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
    "errorCode": { "enum": ["AUTH_UNAVAILABLE", "READ_ONLY_REQUIRED", "DATA_CONTRACT_MISMATCH", "QUERY_FAILED", "RESULT_TOO_LARGE"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F]+$" }
  },
  "examples": [
    {
      "success": false,
      "operation": "kingbase_readonly_preflight",
      "profile": "ai_app_industry_test_ro",
      "schema": "ai_dw",
      "readBoundary": null,
      "objects": [],
      "dataAsOf": null,
      "queryId": "0123456789abcdef",
      "errorCode": "AUTH_UNAVAILABLE",
      "message": "keychain unavailable"
    }
  ],
  "oneOf": [
    {
      "properties": {
        "success": { "const": true },
        "objects": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            {
              "contains": { "type": "object", "required": ["table"], "properties": { "table": { "const": "T_EDW_VAR_PD_INFO_Q" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "required": ["table"], "properties": { "table": { "const": "T_EDW_VAR_PD_IDTY_RELA_Q" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "required": ["table"], "properties": { "table": { "const": "T_EDW_VAR_HCZQ_IDTY_CLAS_Q" } } },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "dataAsOf": { "type": "string" },
        "readBoundary": { "type": "object" }
      },
      "not": { "anyOf": [
        { "required": ["errorCode"], "properties": { "errorCode": {} } },
        { "required": ["message"], "properties": { "message": {} } }
      ] }
    },
    {
      "required": ["errorCode", "message"],
      "properties": { "success": { "const": false }, "objects": { "type": "array", "maxItems": 0 }, "dataAsOf": { "type": "null" }, "readBoundary": { "type": "null" } }
    }
  ]
}
